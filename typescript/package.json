{
  "name": "@atlasent/sdk",
  "version": "2.21.2",
  "description": "Atlasent TypeScript SDK: check that the organization authorized a consequential action before it runs, with signed proof your auditor can verify.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./behavior": {
      "import": {
        "types": "./dist/behavior.d.ts",
        "default": "./dist/behavior.js"
      },
      "require": {
        "types": "./dist/behavior.d.cts",
        "default": "./dist/behavior.cjs"
      }
    },
    "./state": {
      "import": {
        "types": "./dist/state.d.ts",
        "default": "./dist/state.js"
      },
      "require": {
        "types": "./dist/state.d.cts",
        "default": "./dist/state.cjs"
      }
    },
    "./protection-catalog": {
      "import": {
        "types": "./dist/protectionCatalog.d.ts",
        "default": "./dist/protectionCatalog.js"
      },
      "require": {
        "types": "./dist/protectionCatalog.d.cts",
        "default": "./dist/protectionCatalog.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "Chrome >= 103",
    "Firefox >= 100",
    "Safari >= 16"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build",
    "size": "size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit --project tsconfig.examples.json",
    "vendor:trust-root": "node scripts/vendor-trust-root.mjs"
  },
  "keywords": [
    "atlasent",
    "authorization",
    "ai",
    "agents",
    "gxp",
    "compliance",
    "policy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlasent/atlasent-sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/Atlasent/atlasent-sdk/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/Atlasent/atlasent-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@size-limit/esbuild": "^14.0.0",
    "@size-limit/file": "^14.0.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "hono": "^4.12.15",
    "jsdom": "^29.1.0",
    "size-limit": "^14.0.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}

