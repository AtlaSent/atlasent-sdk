{
  "name": "@atlasent/behavior",
  "version": "1.0.1",
  "private": false,
  "description": "AtlaSent Behavior Verification System (BVS) integration — state summary, category aggregates, and evaluate context enrichment",
  "license": "Apache-2.0",
  "keywords": [
    "atlasent",
    "behavior",
    "bvs",
    "authorization",
    "ai",
    "agents",
    "gxp",
    "compliance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlasent/atlasent-sdk.git",
    "directory": "typescript/packages/behavior"
  },
  "homepage": "https://github.com/Atlasent/atlasent-sdk/tree/main/typescript/packages/behavior#readme",
  "bugs": {
    "url": "https://github.com/Atlasent/atlasent-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --no-config",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@atlasent/sdk": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
