{
  "name": "@atlasent/verify",
  "version": "1.0.0",
  "description": "Offline verification of AtlaSent evidence bundles — Ed25519 signature, hash-chain, and Merkle-root checks. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "atlasent-verify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "atlasent",
    "verify",
    "audit",
    "evidence",
    "offline-verification",
    "ed25519",
    "hash-chain",
    "merkle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlasent/atlasent-sdk.git",
    "directory": "typescript/packages/verify-cli"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
